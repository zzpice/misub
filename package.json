{
    "name": "misub",
    "version": "2.7.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:server": "wrangler pages dev dist --port 8787",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\"",
        "format:check": "prettier --check \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\"",
        "test:browser": "node scripts/browser-smoke.mjs"
    },
    "dependencies": {
