        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^20.0.11",
        "jsdom": "^27.4.0",
        "miniflare": "^4.20250803.0",
        "playwright": "^1.60.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.1.12",
        "terser": "^5.48.0",
        "vite": "^7.1.2",
        "vitest": "^4.0.16",
        "wrangler": "^4.56.0"
